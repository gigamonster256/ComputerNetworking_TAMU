---
# clang-tidy configuration. See https://clang.llvm.org/extra/clang-tidy/
# Checks we care about:
#   - casts (no C-style casts)
#   - modern C++ idioms (nullptr, override, etc.)
#   - readability / style consistency
#
# Run with:  nix run .#lint   (or:  make lint)
Checks: >-
  cppcoreguidelines-pro-type-cstyle-cast,
  google-readability-casting,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-redundant-void-arg,
  modernize-redundant-parentheses,
  readability-braces-around-statements,
  readability-redundant-control-flow,
  readability-const-return-type,
  readability-container-size-empty,
  readability-simplify-boolean-expr
WarningsAsErrors: ''
HeaderFilterRegex: '.*'
FormatStyle: file
CheckOptions:
  - key: readability-braces-around-statements.ShortStatementLines
    value: '0'